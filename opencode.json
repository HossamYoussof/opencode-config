{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "gitnexus": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "gitnexus@latest",
          "mcp"
        ]
      },
      "xcodebuild": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "xcodebuildmcp@latest",
          "mcp"
        ]
      },
      "mobile": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mobilenext/mobile-mcp@latest"
        ]
      },
      "ios-simulator": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "ios-simulator-mcp"
        ],
        "disabled": true
      },
      "figma": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "oauth": false,
        "disabled": true
      },
      "firebase": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "firebase-tools@latest",
          "mcp"
        ]
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": true
      },
      "clickup": {
        "type": "remote",
        "url": "https://mcp.clickup.com/mcp",
        "disabled": true
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "disabled": true
      },
      "luciq": {
        "type": "remote",
        "url": "https://api.instabug.com/api/mcp",
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT}"
        }
      }
    }
  },
  "plugins": [
    "opencode-mem@latest",
    "@tarquinen/opencode-dcp@latest",
    "oh-my-opencode-slim@latest"
  ],
